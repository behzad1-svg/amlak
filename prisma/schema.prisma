// املاک ساج — Prisma schema (v3: سرنخ و مشتری یکی شدن، pipeline واحد)
// استک: PostgreSQL + Prisma، یک اپ Next.js واحد

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  AGENT
}

enum CustomerType {
  BUYER
  SELLER
  TENANT
  OWNER
}

enum CustomerTemperature {
  HOT
  WARM
  COLD
}

enum PhonebookGroup {
  BUILDER
  OWNER
  BUYER
  COLLEAGUE
  OTHER
}

// نوع ملک: type در Property/Customer ترجیحاً یکی از مقادیر DEFAULT_PROPERTY_TYPES یا AppSetting است
// (رشته آزاد می‌ماند تا مدیر بتواند از تنظیمات نوع جدید اضافه کند — enum دیتابیسی آن را می‌شکند)
enum PropertyType {
  APARTMENT
  VILLA
  OFFICE
  LAND
  SHOP
  KOLANGI
  COMMERCIAL
}

enum PropertyDealType {
  SALE
  RENT
}

enum PropertyStatus {
  ACTIVE
  RESERVED
  SOLD
  RENTED
  ARCHIVED
}

enum PropertyVisibility {
  TEAM_VISIBLE
  RESTRICTED
}

enum ViewingStatus {
  SCHEDULED
  DONE
  CANCELED
}

/// نتیجهٔ گزارش سه‌ضربه‌ای بازدید — خوشش آمد / متوسط / خوشش نیامد
enum VisitRating {
  LIKED
  MIXED
  NOT_INTERESTED
}

enum SessionCardStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CustomerPipelineStage {
  NEW
  INITIAL_CONTACT
  QUALIFIED
  VIEWING
  CONTRACT
  WON
  FAILED
  LOST
}

enum LostReasonCategory {
  CUSTOMER_WITHDREW
  PRICE_REJECTED
  NO_RESPONSE
  NO_SUITABLE_PROPERTY
  OTHER
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
}

enum CustomerSource {
  INSTAGRAM
  DIVAR
  DIRECT_CALL
  REFERRAL
  SIGN_BOARD
  WEBSITE
  IN_PERSON
  ADVERTISEMENT
  OTHER
  FILE_FINDING
}

enum NotificationType {
  MATCH_SUGGESTION
  FOLLOW_UP_OVERDUE
  VIEWING_REMINDER
  ACCESS_GRANTED
  CUSTOMER_TRANSFERRED
  SESSION_CARD
  ADVERTISED
}

enum ActivityType {
  CALL
  MESSAGE
  MEETING
  NOTE
  APPRAISAL
  ADVERTISED
  SESSION_CARD
  VIEWING_DONE
  STAGE_CHANGE
  OTHER
}

/// شیفت حضور و غیاب: صبح ۰۹:۰۰–۱۳:۰۰، عصر ۱۷:۰۰–۲۱:۰۰
enum AttendanceSession {
  MORNING
  EVENING
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  passwordHash String
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  isContractManager Boolean @default(false)
  permissions  Json     @default("{}")
  tokenVersion Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customersManaged Customer[]          @relation("CustomerAgent")
  listedProperties Property[]          @relation("PropertyLister")
  appraisedProperties Property[]       @relation("PropertyAppraiser")
  propertyAccess   PropertyAccess[]
  accessGranted    PropertyAccess[]    @relation("AccessGrantedBy")
  viewings         Viewing[]           @relation("ViewingAgent")
  deals            Deal[]              @relation("DealAgent")
  dealShares       DealShare[]         @relation("DealShareUser")
  tasks            Task[]              @relation("TaskAgent")
  notifications    Notification[]
  activities       Activity[]
  auditLogs        AuditLog[]
  cashboxEntries CashboxEntry[] @relation("CashboxCreatedBy")
  transfersFrom  CustomerTransfer[] @relation("TransferFrom")
  transfersTo    CustomerTransfer[] @relation("TransferTo")
  transfersBy    CustomerTransfer[] @relation("TransferBy")
  matchDismissals MatchDismissal[] @relation("MatchDismissedBy")
  priceHistoryChanges PriceHistory[] @relation("PriceHistoryChangedBy")
  sessionCards   SessionCard[]      @relation("SessionCardAdvisor")
  sessionCardCoAdvising SessionCardCoAdvisor[] @relation("SessionCardCoAdvisorUser")
  contractManagedSessionCards SessionCard[] @relation("SessionCardContractManager")
  phonebookContacts PhonebookContact[] @relation("PhonebookOwner")
  attendances    Attendance[]
  leaves         Leave[]
  notes          Note[]
}

model Customer {
  id              String               @id @default(cuid())
  name            String
  phone           String
  type            CustomerType
  stage           CustomerPipelineStage @default(NEW)
  temperature     CustomerTemperature  @default(WARM)
  source          CustomerSource?
  tags            String[] @default([])
  notes           String?

  preferredType     String?
  preferredDealType PropertyDealType?
  preferredArea     String?
  preferredAreas    String[] @default([])
  preferredBeds     Int?
  preferredSizeMin  Float?
  preferredSizeMax  Float?
  budgetMin         BigInt?
  budgetMax         BigInt?
  /// سقف بودجه ماهانه اجاره (تومان) — برای RENT جدا از budgetMax (ودیعه)
  budgetMaxMonthly  BigInt?
  description       String?

  nextFollowUpAt  DateTime?

  needsManagerReview       Boolean   @default(false)
  managerReviewReason      String?
  managerReviewRequestedAt DateTime?

  lostReasonCategory LostReasonCategory?
  lostReasonDetail   String?
  lostAt             DateTime?

  deletedAt DateTime?

  assignedAgentId String
  assignedAgent   User                 @relation("CustomerAgent", fields: [assignedAgentId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  ownedProperties Property[]           @relation("PropertyOwner")
  viewings        Viewing[]
  deals           Deal[]
  tasks           Task[]
  activities      Activity[]
  followUps       FollowUp[]
  transfers       CustomerTransfer[] @relation("CustomerTransfers")
  sessionCards    SessionCard[]

  @@index([assignedAgentId])
  @@index([stage])
  @@index([type, temperature])
  @@index([name])
  @@index([assignedAgentId, deletedAt, stage])
  @@index([nextFollowUpAt])
  @@index([deletedAt, createdAt])
  // یک شماره در هر دسته (مالک / مشتری) یک بار برای رکوردهای فعال —
  // یکتایی با partial unique index در دیتابیس است (prisma/partial-unique-customer-phone.sql)؛
  // db push نمی‌تواند partial index بسازد، پس @@unique اینجا نیست
}

// Phonebook (Didar-style): general contacts (builders, owners, colleagues),
// kept separate from Customer so the customer pipeline stays clean.
model PhonebookContact {
  id        String         @id @default(cuid())
  name      String
  phone     String
  phone2    String?
  email     String?
  group     PhonebookGroup @default(OTHER)
  tags      String[]       @default([])
  notes     String?
  isVip     Boolean        @default(false)
  isPinned  Boolean        @default(false)
  isPrivate Boolean        @default(false)
  deletedAt DateTime?

  ownerId   String
  owner     User           @relation("PhonebookOwner", fields: [ownerId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([ownerId])
  @@index([group])
  @@index([name])
  @@index([deletedAt, createdAt])
}

model CustomerTransfer {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation("CustomerTransfers", fields: [customerId], references: [id], onDelete: Cascade)
  fromAgentId String?
  fromAgent   User?    @relation("TransferFrom", fields: [fromAgentId], references: [id], onDelete: SetNull)
  toAgentId   String?
  toAgent     User?    @relation("TransferTo", fields: [toAgentId], references: [id], onDelete: SetNull)
  byUserId    String?
  byUser      User?    @relation("TransferBy", fields: [byUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// مرخصی حضور و غیاب — بدون تایید مدیر؛ مشاور خودش ثبت می‌کند.
/// قانون بهزاد: یا روز قبل (یا زودتر)، یا در خودِ روز حداکثر تا یک ساعت
/// پس از شروع شیفت؛ پس از آن سیستم اجازه نمی‌دهد. date روزِ تهران است.
enum LeaveScope {
  MORNING
  EVENING
  FULL_DAY
}

model Leave {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime   @db.Date
  scope     LeaveScope
  /// دلیل مرخصی — متن آزاد اختیاری که خود مشاور می‌نویسد
  reason    String?
  createdAt DateTime   @default(now())

  @@unique([userId, date, scope])
  @@index([date])
  @@index([userId, date])
}

/// یک رکورد حضور و غیاب برای یک مشاور، یک روز و یک شیفت — بدون عکس و بدون تشخیص چهره؛
/// فقط موقعیت GPS هنگام ورود/خروج. date روزِ تهران است (تاریخِ میلادیِ همان روز).
model Attendance {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime          @db.Date
  session           AttendanceSession
  checkInAt         DateTime?
  checkOutAt        DateTime?
  checkInLat        Float?
  checkInLng        Float?
  checkInDistanceM  Int?
  checkOutLat       Float?
  checkOutLng       Float?
  checkOutDistanceM Int?
  lateMinutes       Int?
  /// دلیل تاخیر — متن آزاد که خود مشاور می‌نویسد؛ هیچ گزینهٔ آماده‌ای نیست
  lateReason        String?
  /// دلیل خروج از بیرون محدوده — متن آزاد که خود مشاور می‌نویسد؛ هیچ گزینهٔ آماده‌ای نیست
  checkOutReason    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([userId, date, session])
  @@index([date])
  @@index([userId, date])
}

model Property {
  id          String             @id @default(cuid())
  /// کد فایل — یکتا، برای ارجاع سریع در بنگاه (مثلا F-0001)
  code        String?            @unique
  title       String
  type        String
  dealType    PropertyDealType

  salePriceToman     BigInt?
  depositToman        BigInt?
  monthlyRentToman    BigInt?

  status      PropertyStatus     @default(ACTIVE)
  /// منبع فایل — از کجا پیدا شده (دیوار، فایل‌یابی، ...)
  source      CustomerSource?
  sizeSqm     Float?
  beds        Int?
  builtYear   Int?
  floor       Int?
  totalFloors Int?
  /// تعداد واحد در هر طبقه (آپارتمان)
  unitsPerFloor Int?
  /// تعداد کل واحدها (آپارتمان)
  unitCount     Int?
  /// متراژ زمین — ویلا/کلنگی/زمین
  landSizeSqm   Float?
  /// عرض گذر (متر)
  passageWidth  Float?
  /// برِ ملک (متر)
  buildingFrontage Float?
  /// تعداد طبقات بنا — ویلا/کلنگی
  buildingFloors   Int?

  hasParking  Boolean            @default(false)
  hasStorage  Boolean            @default(false)
  hasElevator Boolean            @default(false)
  hasTerrace  Boolean            @default(false)
  /// بازسازی‌شده — برای جستجوی بعدی
  hasRenovated Boolean           @default(false)
  /// نوساز — برای جستجوی بعدی
  isNewBuild   Boolean           @default(false)

  region      String
  address     String?
  /// توضیحات/نکات فایل — «مالک عجله دارد»، «قیمت قابل مذاکره است» و...
  description String?
  images      String[]           @default([])

  isAdvertised        Boolean   @default(false)
  nextOwnerFollowUpAt DateTime?

  /// آیا مشاور فایل را حضوری کارشناسی کرده؟
  isAppraised     Boolean    @default(false)
  appraisedById   String?
  appraisedBy     User?      @relation("PropertyAppraiser", fields: [appraisedById], references: [id])
  appraisedAt     DateTime?

  ownerId     String
  owner       Customer           @relation("PropertyOwner", fields: [ownerId], references: [id])

  listedById  String
  listedBy    User               @relation("PropertyLister", fields: [listedById], references: [id])

  visibility  PropertyVisibility @default(TEAM_VISIBLE)
  /// فایل دفتر — همه مشاورها به اطلاعات کامل فایل دسترسی دارند
  isOfficeFile Boolean @default(false)
  accessList  PropertyAccess[]

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  viewings Viewing[]
  deals    Deal[]
  activities Activity[]
  sessionCards SessionCard[]
  priceHistory PriceHistory[]

  @@index([listedById])
  @@index([region])
  @@index([type])
  @@index([dealType])
  @@index([status, visibility])
  @@index([dealType, status])
  @@index([region, type, dealType, status, deletedAt])
  @@index([source])
  @@index([ownerId])
  @@index([appraisedById])
  @@index([deletedAt, createdAt])
}

model PropertyAccess {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  grantedById String
  grantedBy   User      @relation("AccessGrantedBy", fields: [grantedById], references: [id])
  reason      String?
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?

  @@unique([propertyId, userId])
  @@index([revokedAt, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Viewing {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  propertyId String
  property   Property      @relation(fields: [propertyId], references: [id])
  agentId    String
  agent      User          @relation("ViewingAgent", fields: [agentId], references: [id])
  startAt    DateTime
  endAt      DateTime?
  status     ViewingStatus @default(SCHEDULED)
  feedback   String?
  /// گزارش سه‌ضربه‌ای بازدید (بعد از انجام بازدید ثبت می‌شود)
  rating        VisitRating?
  reportComment String?
  reportedAt    DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([agentId])
  @@index([propertyId])
  @@index([customerId])
  @@index([status, startAt])
}

/// کارت جلسه — هماهنگی پیش از قرارداد بین مشاور و مدیر؛
/// پیش‌تر روی کاغذ پر می‌شد، حالا داخل سایت با اعلان فوری برای مدیر.
model SessionCard {
  id                 String            @id @default(cuid())
  customerId         String
  customer           Customer          @relation(fields: [customerId], references: [id])
  propertyId         String?
  property           Property?         @relation(fields: [propertyId], references: [id])
  advisorId          String
  advisor            User              @relation("SessionCardAdvisor", fields: [advisorId], references: [id])
  coAdvisors           SessionCardCoAdvisor[]
  contractManagerId    String?
  contractManager      User?             @relation("SessionCardContractManager", fields: [contractManagerId], references: [id])
  scheduledAt        DateTime
  cashAmountToman    BigInt?
  depositAmountToman BigInt?
  rentAmountToman    BigInt?
  intent             String?
  sellerShiriniToman BigInt?
  depositPaid        Boolean?
  commissionToman    BigInt?
  paymentTerms       String?
  notes              String?
  status             SessionCardStatus @default(PENDING)
  managerNote        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([advisorId])
  @@index([contractManagerId])
  @@index([status, scheduledAt])
  @@index([customerId])
  @@index([propertyId])
}

model SessionCardCoAdvisor {
  id            String      @id @default(cuid())
  sessionCardId String
  sessionCard   SessionCard @relation(fields: [sessionCardId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation("SessionCardCoAdvisorUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([sessionCardId, userId])
  @@index([sessionCardId])
  @@index([userId])
}

enum DealStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum CashboxType {
  IN
  OUT
}

model Deal {
  id         String     @id @default(cuid())
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id])
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id])
  agentId    String
  agent      User       @relation("DealAgent", fields: [agentId], references: [id])
  shares     DealShare[]
  cashboxEntries CashboxEntry[]

  status      DealStatus @default(PENDING)
  contractAt  DateTime?
  notes       String?
  commissionToman   BigInt?
  commissionPercent Float?
  /// نرخ مالیات (٪) مهرشده در لحظه ثبت کمیسیون؛ تغییر نرخ جاری روی آن اثر ندارد
  taxRatePct        Float?
  sellerShiriniToman BigInt?
  buyerShiriniToman  BigInt?
  discountToman      BigInt?
  /// کمیسیون و مالیات دوطرفه (از ۲ آذر ۱۴۰۵): هر طرف جدا حساب می‌شود —
  /// فروش: فروشنده/خریدار، اجاره: مالک/مستاجر. commissionToman جمع دو طرف
  /// است (برای سازگاری با گزارش‌های قدیمی) و discountToman جمع تخفیف دو طرف؛
  /// معامله‌های قدیمی این فیلدها را ندارند و همان تک‌کمیسیون قبلی را می‌بینند.
  sellerCommissionToman   BigInt?
  sellerCommissionPercent Float?
  buyerCommissionToman    BigInt?
  buyerCommissionPercent  Float?
  sellerReceivedToman     BigInt?
  buyerReceivedToman      BigInt?
  sellerDiscountToman     BigInt?
  buyerDiscountToman      BigInt?
  commissionPaid    Boolean  @default(false)
  commissionPaidAt  DateTime?
  officePct         Decimal  @default(50) @db.Decimal(5, 2)
  /// سهم دفتر از شیرینی (٪) — جدا از سهم دفتر از کمیسیون (officePct)؛ خالی
  /// یعنی همان officePct (معامله‌های قدیمی دقیقاً همان مبلغ قبلی را می‌بینند).
  officeShiriniPct  Decimal? @db.Decimal(5, 2)

  dealSalePriceToman   BigInt?
  dealDepositToman     BigInt?
  dealMonthlyRentToman BigInt?

  canceledAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId, status])
  @@index([propertyId, status])
  @@index([agentId, status])
  @@index([status, createdAt])
}

model DealShare {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  cashboxEntries CashboxEntry[]
  userId    String?
  user      User?    @relation("DealShareUser", fields: [userId], references: [id], onDelete: SetNull)
  name      String
  pct       Decimal  @db.Decimal(5, 2)
  /// سهم این ردیف از شیرینی (٪) — جدا از سهم از کمیسیون (pct)؛ خالی یعنی همان pct.
  shiriniPct Decimal? @db.Decimal(5, 2)
  settled   Boolean  @default(false)
  settledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@index([userId])
}

model CashboxEntry {
  id          String      @id @default(cuid())
  type        CashboxType
  amount      BigInt
  title       String
  note        String?
  occurredAt  DateTime    @default(now())
  createdById String
  createdBy   User        @relation("CashboxCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  dealId      String?
  deal        Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  shareId     String?
  share       DealShare? @relation(fields: [shareId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([createdById])
  @@index([dealId])
  @@index([shareId])
}

model FollowUp {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dueAt      DateTime
  note       String?
  done       Boolean  @default(false)
  doneAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, done, dueAt])
  @@index([customerId, dueAt])
}

model Task {
  id              String    @id @default(cuid())
  relatedType     String?
  relatedId       String?
  title           String
  dueAt           DateTime?
  priority        Int       @default(0)
  done            Boolean   @default(false)
  assignedAgentId String
  assignedAgent   User      @relation("TaskAgent", fields: [assignedAgentId], references: [id])
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([assignedAgentId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("")
  content   String
  remindAt  DateTime?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
  type        NotificationType
  priority    NotificationPriority @default(NORMAL)
  relatedType String?
  relatedId   String?
  message     String
  read        Boolean              @default(false)
  readAt      DateTime?
  createdAt   DateTime             @default(now())

  @@index([userId, read, createdAt])
}

model Activity {
  id              String       @id @default(cuid())
  type            ActivityType
  agentId         String
  agent           User         @relation(fields: [agentId], references: [id])
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id])
  propertyId      String?
  property        Property?    @relation(fields: [propertyId], references: [id])
  description     String?
  durationMinutes Int?
  costToman       Int?
  oldValue        String?
  newValue        String?
  createdAt       DateTime     @default(now())

  @@index([agentId, createdAt])
  @@index([customerId, createdAt])
  @@index([propertyId, createdAt])
}


/// «علاقه‌ای ندارد» روی یک تطبیق — تطبیق از لیست‌ها پنهان می‌شود، ولی داده
/// پاک نمی‌شود؛ با لغو رد، تطبیق دوباره دیده می‌شود.
model MatchDismissal {
  id            String   @id @default(cuid())
  customerId    String
  propertyId    String
  dismissedById String
  dismissedBy   User     @relation("MatchDismissedBy", fields: [dismissedById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([customerId, propertyId])
  @@index([customerId])
  @@index([propertyId])
}

/// تاریخچه قیمت فایل — هر تغییر قیمت (فروش/رهن/اجاره) با قیمت قبل و بعد،
/// زمان تغییر و ثبت‌کننده؛ قیمت معامله جدا می‌ماند و اینجا ثبت نمی‌شود.
model PriceHistory {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// SALE_PRICE | DEPOSIT | MONTHLY_RENT
  field       String
  oldValue    BigInt?
  newValue    BigInt?
  changedById String
  changedBy   User     @relation("PriceHistoryChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([propertyId, createdAt])
}

/// ثبت خطاهای سمت سرور برای مشاهده توسط مدیر (نقد ۶ — مشاهده‌پذیری).
/// اگر جدول در دیتابیس نباشد، logApiError به console.error برمی‌گردد و خطا نمی‌دهد.
model ApiErrorLog {
  id        String   @id @default(cuid())
  route     String
  method    String
  status    Int
  message   String
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([route, createdAt])
}

/// کد بازیابی رمز با پیامک — یک کد فعال برای هر شماره؛ کد فقط به‌صورت هش
/// ذخیره می‌شود، ۱۰ دقیقه اعتبار دارد، یک بار مصرف است و پس از ۵ تلاش
/// ناموفق باطل می‌شود.
model PasswordResetCode {
  phone      String   @id
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  verifiedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// شمارندهٔ محدودیت نرخ ورود (نقد ۱۳) — جایگزین دیتابیسیِ محدودیت درون‌حافظه‌ای.
/// اگر جدول نباشد، rateLimitDb به حافظه برمی‌گردد.
model RateLimitHit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(1)
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

/// ثبت هر پشتیبان (دستی یا شبانه) — چه کسی، چه وقت، کجا.
enum BackupKind {
  MANUAL
  NIGHTLY
}

enum BackupStatus {
  OK
  FAILED
}

model BackupLog {
  id          String       @id @default(cuid())
  userId      String?
  userName    String
  kind        BackupKind
  destination String
  fileName    String
  sizeBytes   BigInt?
  status      BackupStatus @default(OK)
  note        String?
  createdAt   DateTime     @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
}
