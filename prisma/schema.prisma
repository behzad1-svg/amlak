// املاک ساج — Prisma schema (v3: سرنخ و مشتری یکی شدن، pipeline واحد)
// استک: PostgreSQL + Prisma، یک اپ Next.js واحد

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  AGENT
}

// نکته: این فقط یه برچسب توصیفیه، محدودکننده نیست — یه Customer با type=BUYER هنوز می‌تونه
// از طریق رابطه‌ی ownedProperties مالک فایل هم باشه (مثلاً کسی که می‌فروشه تا بزرگ‌تر بخره)
enum CustomerType {
  BUYER
  SELLER
  TENANT
}



enum CustomerTemperature {
  HOT
  WARM
  COLD
}

enum PropertyType {
  APARTMENT
  VILLA
  OFFICE
  LAND
  SHOP
}

// فروش، جدا از رهن‌واجاره — چون رهن‌واجاره دو تا عدد لازم داره نه یکی
enum PropertyDealType {
  SALE
  RENT
}

enum PropertyStatus {
  ACTIVE
  RESERVED
  SOLD
  RENTED
}

enum PropertyVisibility {
  TEAM_VISIBLE
  RESTRICTED
}

enum ViewingStatus {
  SCHEDULED
  DONE
  CANCELED
}

// Customer Pipeline Stage — مشتری تو کدام مرحله است (Kanban دستی)
enum CustomerPipelineStage {
  NEW                    // تازه‌وارد، هنوز تماسی گرفته نشده
  INITIAL_CONTACT       // تماس اولیه گرفته شده
  QUALIFIED             // نیاز سنجی شده
  VIEWING               // در حال دیدن ملک‌ها
  CONTRACT              // قرارداد (مرحله نهایی v1)
  LOST                  // منصرف شده
}

enum LostReasonCategory {
  CUSTOMER_WITHDREW      // منصرف شد
  PRICE_REJECTED         // قیمت پیشنهادی رو قبول نکرد
  NO_RESPONSE            // دیگه پاسخ نمی‌ده
  NO_SUITABLE_PROPERTY   // فایل مناسب نداشتیم
  OTHER                  // سایر (با توضیح آزاد)
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH        // مثلاً پیگیری عقب‌افتاده، match بالای ۹۰٪
}

enum CustomerSource {
  INSTAGRAM
  DIVAR
  DIRECT_CALL
  REFERRAL
  SIGN_BOARD   // تابلو
  WEBSITE
  OTHER
}

enum NotificationType {
  MATCH_SUGGESTION
  FOLLOW_UP_OVERDUE
  VIEWING_REMINDER
  ACCESS_GRANTED
}

// هر کاری که مشاور انجام می‌ده به‌عنوان یه رکورد Activity ثبت می‌شه —
// پایه‌ی هم Timeline مشتری/فایل، هم آمار مدیر از کارکرد هر مشاوره
enum ActivityType {
  CALL
  MESSAGE
  MEETING
  NOTE
  APPRAISAL          // کارشناسی ملک
  ADVERTISED          // آگهی‌کردن یه فایل مشخص
  VIEWING_DONE
  STAGE_CHANGE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  passwordHash String
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  tokenVersion Int      @default(1) // با +۱ شدن، تمام Tokenهای قدیمی فوری باطل می‌شوند (تغییر رمز، قطع دسترسی فوری)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customersManaged Customer[]       @relation("CustomerAgent")
  listedProperties Property[]       @relation("PropertyLister")
  propertyAccess   PropertyAccess[]
  accessGranted    PropertyAccess[] @relation("AccessGrantedBy")
  viewings         Viewing[]        @relation("ViewingAgent")
  deals            Deal[]           @relation("DealAgent")
  tasks            Task[]           @relation("TaskAgent")
  notifications    Notification[]
  activities       Activity[]
  auditLogs        AuditLog[]
  passwordResetTokens PasswordResetToken[]
}

// موجودیت واحد: هم سرنخ اولیه، هم مشتری، هم (احتمالاً) مالک یه فایل.
// stage مشخص می‌کنه کجای pipeline هست؛ وقتی به CONTRACT برسه یعنی معامله بسته شده.
model Customer {
  id              String               @id @default(cuid())
  name            String
  phone           String               // نکته‌ی migration: unique نباشه در سطح Prisma —
  // باید یه Partial Unique Index دستی رو Postgres ساخته بشه: UNIQUE(phone) WHERE "deletedAt" IS NULL
  // چون Prisma از Partial Index پشتیبانی نمی‌کنه؛ وگرنه بعد از حذف نرم یه مشتری، اون شماره دیگه هیچ‌وقت قابل ثبت مجدد نیست
  type            CustomerType
  stage           CustomerPipelineStage @default(NEW)
  temperature     CustomerTemperature  @default(WARM)
  source          CustomerSource?      // اینستاگرام، دیوار، تماس مستقیم، معرفی...
  notes           String?

  // ترجیحات برای موتور تطبیق خودکار
  preferredType     PropertyType?
  preferredDealType PropertyDealType?  // دنبال خرید/فروش یا رهن‌واجاره؟
  preferredArea     String?
  preferredBeds     Int?
  preferredSizeMin  Float?             // متراژ (اعشاری، چون مثلاً ۸۵.۵ متر رایجه)
  preferredSizeMax  Float?
  budgetMin         BigInt?            // برای خرید: کل قیمت / برای رهن‌واجاره: عرف بازار (تبدیل به رهن کامل) — BigInt چون Int 32-بیتی تا ۲.۱ میلیارد بیشتر جا نمی‌شه
  budgetMax         BigInt?

  // پیگیری اجباری — تا تعیین نشه/بگذره، تو داشبورد «امروز» قرمز و بالای لیست می‌مونه
  // نکته: وقتی stage=LOST بشه، دیگه این فیلد اجباری/قرمز نیست — مشتری بسته شده، پیگیری بی‌معنیه
  nextFollowUpAt  DateTime?

  // Escape Hatch — به‌جای تاریخ الکی، مشاور می‌تواند رسماً بگوید "نیاز به بازنگری مدیر"
  // نکته‌ی پیاده‌سازی: وقتی این true می‌شه، باید خودکار یه Notification به همه‌ی OWNERها ساخته بشه
  needsManagerReview       Boolean   @default(false)
  managerReviewReason      String?
  managerReviewRequestedAt DateTime?

  // اتمام کار — وقتی مشاور تصمیم می‌گیرد دیگر روی این مشتری کار نکند (منصرف شد یا خودش نمی‌خواهد ادامه دهد)
  lostReasonCategory LostReasonCategory?  // اجباری وقتی stage=LOST — از لیست از‌پیش‌تعریف‌شده
  lostReasonDetail   String?              // توضیح آزاد، مخصوصاً برای OTHER
  lostAt             DateTime?

  deletedAt DateTime? // Soft delete — حذف فیزیکی نمی‌شه، فقط مخفی می‌شه
  // نکته: Query هایی که owner یه Property رو نشون می‌دن، نباید بر اساس deletedAt فیلترش کنن —
  // حتی مالک soft-delete شده باید تو صفحه‌ی فایل به‌عنوان مالک نشون داده بشه (نه پنهان/orphan)

  assignedAgentId String
  assignedAgent   User                 @relation("CustomerAgent", fields: [assignedAgentId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  ownedProperties Property[]           @relation("PropertyOwner")
  viewings        Viewing[]
  deals           Deal[]
  tasks           Task[]
  activities      Activity[]

  @@index([assignedAgentId])
  @@index([stage])
  @@index([type, temperature])
  @@index([name])   // برای جستجوی مشاورا؛ برای مقیاس ما (نه صدهزار رکورد) کافیه —
  // اگه بعداً حجم بالا رفت، برای جستجوی substring واقعی (LIKE '%x%') به pg_trgm/GIN index نیاز داریم
  @@index([assignedAgentId, deletedAt, stage]) // ایندکس ترکیبی برای داشبورد هر مشاور
  @@index([nextFollowUpAt])
}

model Property {
  id          String             @id @default(cuid())
  title       String
  type        PropertyType
  dealType    PropertyDealType   // فروش یا رهن‌واجاره — دسته‌بندی اصلی فایل‌ها

  // فروش: فقط این پر می‌شه
  salePriceToman     BigInt?    // BigInt، نه Int — قیمت ملک معمولاً بیشتر از ظرفیت Int 32-بیتی (۲.۱ میلیارد) است

  // رهن‌واجاره: این دوتا پر می‌شن (نه salePriceToman)
  depositToman        BigInt?     // رهن
  monthlyRentToman    BigInt?     // اجاره ماهانه

  status      PropertyStatus     @default(ACTIVE)
  sizeSqm     Float?              // اعشاری (مثلاً ۸۵.۵ متر)
  beds        Int?
  builtYear   Int?               // سال ساخت
  floor       Int?
  totalFloors Int?
  hasParking  Boolean            @default(false)
  hasStorage  Boolean            @default(false)
  region      String
  address     String?
  images      String[]           @default([])

  // پیگیری خود فایل (نه فقط مشتری) — سبک، نه اجباری مثل مشتری
  isAdvertised        Boolean   @default(false)  // آگهی شده یا نه
  nextOwnerFollowUpAt DateTime?                   // پیگیری بعدی با مالک

  ownerId     String
  owner       Customer           @relation("PropertyOwner", fields: [ownerId], references: [id])

  listedById  String
  listedBy    User               @relation("PropertyLister", fields: [listedById], references: [id])

  visibility  PropertyVisibility @default(TEAM_VISIBLE)
  accessList  PropertyAccess[]

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?          // Soft delete

  viewings Viewing[]
  deals    Deal[]
  activities Activity[]

  @@index([listedById])
  @@index([region])
  @@index([type])
  @@index([dealType])
  @@index([status, visibility])
  @@index([dealType, status])
  @@index([region, type, dealType, status, deletedAt]) // موتور تطبیق همیشه باید deletedAt:null رو فیلترش لحاظ کنه
}

// دسترسی موقت به فایل RESTRICTED — می‌تواند منقضی یا لغو شود
// نکته‌ی پیاده‌سازی: هر بار که رکورد جدید ساخته می‌شه، باید خودکار یه Notification به userId (گیرنده) بره
model PropertyAccess {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  grantedById String
  grantedBy  User      @relation("AccessGrantedBy", fields: [grantedById], references: [id])
  reason     String?
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?

  @@index([propertyId, userId]) // نه @@unique — چون بعد از revoke باید بشه دوباره grant کرد؛
  // منطق اپلیکیشن باید چک کنه رکورد فعال (revokedAt=null) قبلی هست یا نه، و اگه هست update کنه نه insert
  @@index([revokedAt, expiresAt]) // ترتیب اول revokedAt چون تساویه (IS NULL)، بعد expiresAt (رنج)
}

// نکته‌ی پیاده‌سازی حیاتی: هر Query که چک می‌کنه "آیا این کاربر دسترسی داره؟"
// باید صراحتاً این شرط رو رعایت کنه: expiresAt IS NULL OR expiresAt > now()  AND  revokedAt IS NULL
// وگرنه دسترسیِ منقضی/لغوشده هنوز باز می‌مونه. این باید یه تابع/helper مشترک باشه، نه تکرار دستی تو هر Endpoint.
//
// نکته‌ی migration دستی (مثل phone): برای جلوگیری از race condition (دو درخواست هم‌زمان = دو رکورد فعال
// برای یک property+user)، باید یه Partial Unique Index دستی رو Postgres ساخته بشه:
// CREATE UNIQUE INDEX property_access_active_unique ON "PropertyAccess" ("propertyId", "userId")
// WHERE "revokedAt" IS NULL AND ("expiresAt" IS NULL OR "expiresAt" > NOW());

// لاگ Immutable — فقط Insert، هرگز Update/Delete (حتی از UI مدیر)
// اطلاعات حساس (پسورد، شماره تماس خام) هرگز اینجا ذخیره نمی‌شود
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String   // مثلاً PROPERTY_PRICE_UPDATED, ACCESS_GRANTED, EXPORT_CUSTOMERS
  entityType String
  entityId   String
  oldValue   String?  // JSON، بدون فیلدهای حساس
  newValue   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

// توکن یک‌بارمصرف برای فراموشی رمز — همیشه هش (نه خام) ذخیره می‌شه، مثل پسورد
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime? // وقتی استفاده شد، دیگه قابل استفاده‌ی مجدد نیست
  createdAt DateTime  @default(now())

  @@index([userId])
}

// بازدید — هر مشاوری می‌تواند برای هر فایلی (حتی مال مشاور دیگر) بازدید ثبت کند؛
// agentId = کسی که واقعاً بازدید را انجام/ثبت کرده، نه لزوماً صاحب فایل یا مشتری
model Viewing {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  propertyId String
  property   Property      @relation(fields: [propertyId], references: [id])
  agentId    String
  agent      User          @relation("ViewingAgent", fields: [agentId], references: [id])
  startAt    DateTime
  endAt      DateTime?  // اختیاری — موقع SCHEDULED معمولاً دقیق معلوم نیست
  status     ViewingStatus @default(SCHEDULED)
  feedback   String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([agentId])
  @@index([propertyId])
}

// Deal = "مشتری + ملک + مبلغ معامله"
// برای v1: نشانه‌گذار + مبلغ نهایی. برای رهن‌واجاره، رهن/اجاره جدا (مثل Property) — نه یه عدد مبهم
model Deal {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id])
  agentId    String
  agent      User      @relation("DealAgent", fields: [agentId], references: [id])

  // فروش: فقط این پر می‌شه
  dealSalePriceToman   BigInt?
  // رهن‌واجاره: این دوتا پر می‌شن
  dealDepositToman     BigInt?
  dealMonthlyRentToman BigInt?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([customerId, propertyId])
  @@index([agentId])
}

model Task {
  id              String    @id @default(cuid())
  // نکته‌ی طراحی: customerId رابطه‌ی صریح Prisma برای رایج‌ترین حالت (پیگیری با یه مشتری) —
  // relatedType/relatedId فقط برای حالت‌های دیگه (مثلاً Task مرتبط با Property) استفاده می‌شه،
  // نه هردو برای یک چیز. وقتی customerId پره، relatedType/relatedId نادیده گرفته می‌شن.
  relatedType     String?
  relatedId       String?
  title           String
  dueAt           DateTime?
  priority        Int       @default(0) // 0: عادی, 1: مهم, 2: فوری — برای ترتیب‌بندی تو داشبورد
  done            Boolean   @default(false)
  assignedAgentId String
  assignedAgent   User      @relation("TaskAgent", fields: [assignedAgentId], references: [id])
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([assignedAgentId])
}

// خودِ این جدول (createdAt + read) پاسخ «چرا این Match رو ندیدم؟» رو می‌ده —
// نیازی نیست تولید/خواندن Notification تو AuditLog جدا هم ثبت بشه؛ تکرار داده‌ست
model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  type        NotificationType
  priority    NotificationPriority @default(NORMAL)
  relatedType String?
  relatedId   String?
  message     String
  read        Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, read, createdAt])
}

// لاگ کامل هر کاری که مشاور انجام می‌ده — پایه‌ی Timeline و آمار مدیر.
// آمار مدیر = همین جدول با فیلتر agentId (تعداد + قابلیت کلیک برای دیدن لیست کامل)
model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  agentId    String
  agent      User         @relation(fields: [agentId], references: [id])
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id])
  propertyId String?
  property   Property?    @relation(fields: [propertyId], references: [id])
  description String?
  durationMinutes Int?     // برای CALL — مدت تماس
  costToman       Int?     // برای ADVERTISED — هزینه‌ی آگهی
  oldValue    String?      // برای STAGE_CHANGE: مرحله‌ی قبلی
  newValue    String?      // برای STAGE_CHANGE: مرحله‌ی جدید
  createdAt  DateTime     @default(now())

  @@index([agentId, createdAt])
  @@index([customerId, createdAt])
  @@index([propertyId, createdAt])
}
