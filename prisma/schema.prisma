// املاک ساج — Prisma schema (v3: سرنخ و مشتری یکی شدن، pipeline واحد)
// استک: PostgreSQL + Prisma، یک اپ Next.js واحد

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  AGENT
}

enum CustomerType {
  BUYER
  SELLER
  TENANT
}

enum CustomerTemperature {
  HOT
  WARM
  COLD
}

enum PropertyType {
  APARTMENT
  VILLA
  OFFICE
  LAND
  SHOP
}

enum PropertyDealType {
  SALE
  RENT
}

enum PropertyStatus {
  ACTIVE
  RESERVED
  SOLD
  RENTED
}

enum PropertyVisibility {
  TEAM_VISIBLE
  RESTRICTED
}

enum ViewingStatus {
  SCHEDULED
  DONE
  CANCELED
}

enum CustomerPipelineStage {
  NEW
  INITIAL_CONTACT
  QUALIFIED
  VIEWING
  CONTRACT
  LOST
}

enum LostReasonCategory {
  CUSTOMER_WITHDREW
  PRICE_REJECTED
  NO_RESPONSE
  NO_SUITABLE_PROPERTY
  OTHER
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
}

enum CustomerSource {
  INSTAGRAM
  DIVAR
  DIRECT_CALL
  REFERRAL
  SIGN_BOARD
  WEBSITE
  OTHER
}

enum NotificationType {
  MATCH_SUGGESTION
  FOLLOW_UP_OVERDUE
  VIEWING_REMINDER
  ACCESS_GRANTED
}

enum ActivityType {
  CALL
  MESSAGE
  MEETING
  NOTE
  APPRAISAL
  ADVERTISED
  VIEWING_DONE
  STAGE_CHANGE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  passwordHash String
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  tokenVersion Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customersManaged Customer[]       @relation("CustomerAgent")
  listedProperties Property[]       @relation("PropertyLister")
  propertyAccess   PropertyAccess[]
  accessGranted    PropertyAccess[] @relation("AccessGrantedBy")
  viewings         Viewing[]        @relation("ViewingAgent")
  deals            Deal[]           @relation("DealAgent")
  tasks            Task[]           @relation("TaskAgent")
  notifications    Notification[]
  activities       Activity[]
  auditLogs        AuditLog[]
  passwordResetTokens PasswordResetToken[]
}

model Customer {
  id              String               @id @default(cuid())
  name            String
  phone           String
  type            CustomerType
  stage           CustomerPipelineStage @default(NEW)
  temperature     CustomerTemperature  @default(WARM)
  source          CustomerSource?
  notes           String?

  preferredType     PropertyType?
  preferredDealType PropertyDealType?
  preferredArea     String?
  preferredBeds     Int?
  preferredSizeMin  Float?
  preferredSizeMax  Float?
  budgetMin         Int?
  budgetMax         Int?

  nextFollowUpAt  DateTime?
  needsManagerReview       Boolean   @default(false)
  managerReviewReason      String?
  managerReviewRequestedAt DateTime?

  lostReasonCategory LostReasonCategory?
  lostReasonDetail   String?
  lostAt             DateTime?

  deletedAt DateTime?

  assignedAgentId String
  assignedAgent   User                 @relation("CustomerAgent", fields: [assignedAgentId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  ownedProperties Property[]           @relation("PropertyOwner")
  viewings        Viewing[]
  deals           Deal[]
  tasks           Task[]
  activities      Activity[]

  @@index([assignedAgentId])
  @@index([stage])
  @@index([type, temperature])
  @@index([nextFollowUpAt])
}

model Property {
  id          String             @id @default(cuid())
  title       String
  type        PropertyType
  dealType    PropertyDealType

  salePriceToman     Int?
  depositToman        Int?
  monthlyRentToman    Int?

  status      PropertyStatus     @default(ACTIVE)
  sizeSqm     Float?
  beds        Int?
  builtYear   Int?
  floor       Int?
  totalFloors Int?
  hasParking  Boolean            @default(false)
  hasStorage  Boolean            @default(false)
  region      String
  address     String?
  images      String[]           @default([])

  isAdvertised        Boolean   @default(false)
  nextOwnerFollowUpAt DateTime?

  ownerId     String
  owner       Customer           @relation("PropertyOwner", fields: [ownerId], references: [id])

  listedById  String
  listedBy    User               @relation("PropertyLister", fields: [listedById], references: [id])

  visibility  PropertyVisibility @default(TEAM_VISIBLE)
  accessList  PropertyAccess[]

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  viewings Viewing[]
  deals    Deal[]
  activities Activity[]

  @@index([listedById])
  @@index([region])
  @@index([type])
  @@index([dealType])
  @@index([status, visibility])
  @@index([dealType, status])
  @@index([region, type, dealType, status])
}

model PropertyAccess {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  grantedById String
  grantedBy  User      @relation("AccessGrantedBy", fields: [grantedById], references: [id])
  reason     String?
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?

  @@index([propertyId, userId])
  @@index([revokedAt, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Viewing {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  propertyId String
  property   Property      @relation(fields: [propertyId], references: [id])
  agentId    String
  agent      User          @relation("ViewingAgent", fields: [agentId], references: [id])
  startAt    DateTime
  endAt      DateTime?
  status     ViewingStatus @default(SCHEDULED)
  feedback   String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([agentId])
  @@index([propertyId])
}

model Deal {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id])
  agentId    String
  agent      User      @relation("DealAgent", fields: [agentId], references: [id])

  dealSalePriceToman   Int?
  dealDepositToman     Int?
  dealMonthlyRentToman Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([customerId, propertyId])
  @@index([agentId])
}

model Task {
  id              String    @id @default(cuid())
  relatedType     String
  relatedId       String
  title           String
  dueAt           DateTime?
  priority        Int       @default(0)
  done            Boolean   @default(false)
  assignedAgentId String
  assignedAgent   User      @relation("TaskAgent", fields: [assignedAgentId], references: [id])
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([assignedAgentId])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  type        NotificationType
  priority    NotificationPriority @default(NORMAL)
  relatedType String?
  relatedId   String?
  message     String
  read        Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, read, createdAt])
}

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  agentId    String
  agent      User         @relation(fields: [agentId], references: [id])
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id])
  propertyId String?
  property   Property?    @relation(fields: [propertyId], references: [id])
  description String?
  durationMinutes Int?
  costToman       Int?
  oldValue    String?
  newValue    String?
  createdAt  DateTime     @default(now())

  @@index([agentId, createdAt])
  @@index([customerId, createdAt])
  @@index([propertyId, createdAt])
}