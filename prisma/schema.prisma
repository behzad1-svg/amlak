// املاک ساج — Prisma schema (v3: سرنخ و مشتری یکی شدن، pipeline واحد)
// استک: PostgreSQL + Prisma، یک اپ Next.js واحد

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  AGENT
}

enum CustomerType {
  BUYER
  SELLER
  TENANT
  OWNER
}

enum CustomerTemperature {
  HOT
  WARM
  COLD
}

// نوع ملک: type در Property/Customer ترجیحاً یکی از مقادیر DEFAULT_PROPERTY_TYPES یا AppSetting است
// (رشته آزاد می‌ماند تا مدیر بتواند از تنظیمات نوع جدید اضافه کند — enum دیتابیسی آن را می‌شکند)
enum PropertyType {
  APARTMENT
  VILLA
  OFFICE
  LAND
  SHOP
  KOLANGI
  COMMERCIAL
}

enum PropertyDealType {
  SALE
  RENT
}

enum PropertyStatus {
  ACTIVE
  RESERVED
  SOLD
  RENTED
  ARCHIVED
}

enum PropertyVisibility {
  TEAM_VISIBLE
  RESTRICTED
}

enum ViewingStatus {
  SCHEDULED
  DONE
  CANCELED
}

enum CustomerPipelineStage {
  NEW
  INITIAL_CONTACT
  QUALIFIED
  VIEWING
  CONTRACT
  WON
  FAILED
  LOST
}

enum LostReasonCategory {
  CUSTOMER_WITHDREW
  PRICE_REJECTED
  NO_RESPONSE
  NO_SUITABLE_PROPERTY
  OTHER
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
}

enum CustomerSource {
  INSTAGRAM
  DIVAR
  DIRECT_CALL
  REFERRAL
  SIGN_BOARD
  WEBSITE
  IN_PERSON
  ADVERTISEMENT
  OTHER
  FILE_FINDING
}

enum NotificationType {
  MATCH_SUGGESTION
  FOLLOW_UP_OVERDUE
  VIEWING_REMINDER
  ACCESS_GRANTED
  CUSTOMER_TRANSFERRED
}

enum ActivityType {
  CALL
  MESSAGE
  MEETING
  NOTE
  APPRAISAL
  ADVERTISED
  VIEWING_DONE
  STAGE_CHANGE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  passwordHash String
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  permissions  Json     @default("{}")
  tokenVersion Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customersManaged Customer[]          @relation("CustomerAgent")
  listedProperties Property[]          @relation("PropertyLister")
  appraisedProperties Property[]       @relation("PropertyAppraiser")
  propertyAccess   PropertyAccess[]
  accessGranted    PropertyAccess[]    @relation("AccessGrantedBy")
  viewings         Viewing[]           @relation("ViewingAgent")
  deals            Deal[]              @relation("DealAgent")
  dealShares       DealShare[]         @relation("DealShareUser")
  tasks            Task[]              @relation("TaskAgent")
  notifications    Notification[]
  activities       Activity[]
  auditLogs        AuditLog[]
  cashboxEntries CashboxEntry[] @relation("CashboxCreatedBy")
  transfersFrom  CustomerTransfer[] @relation("TransferFrom")
  transfersTo    CustomerTransfer[] @relation("TransferTo")
  transfersBy    CustomerTransfer[] @relation("TransferBy")
}

model Customer {
  id              String               @id @default(cuid())
  name            String
  phone           String
  type            CustomerType
  stage           CustomerPipelineStage @default(NEW)
  temperature     CustomerTemperature  @default(WARM)
  source          CustomerSource?
  tags            String[] @default([])
  notes           String?

  preferredType     String?
  preferredDealType PropertyDealType?
  preferredArea     String?
  preferredAreas    String[] @default([])
  preferredBeds     Int?
  preferredSizeMin  Float?
  preferredSizeMax  Float?
  budgetMin         BigInt?
  budgetMax         BigInt?
  /// سقف بودجه ماهانه اجاره (تومان) — برای RENT جدا از budgetMax (ودیعه)
  budgetMaxMonthly  BigInt?
  description       String?

  nextFollowUpAt  DateTime?

  needsManagerReview       Boolean   @default(false)
  managerReviewReason      String?
  managerReviewRequestedAt DateTime?

  lostReasonCategory LostReasonCategory?
  lostReasonDetail   String?
  lostAt             DateTime?

  deletedAt DateTime?

  assignedAgentId String
  assignedAgent   User                 @relation("CustomerAgent", fields: [assignedAgentId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  ownedProperties Property[]           @relation("PropertyOwner")
  viewings        Viewing[]
  deals           Deal[]
  tasks           Task[]
  activities      Activity[]
  followUps       FollowUp[]
  transfers       CustomerTransfer[] @relation("CustomerTransfers")

  @@index([assignedAgentId])
  @@index([stage])
  @@index([type, temperature])
  @@index([name])
  @@index([assignedAgentId, deletedAt, stage])
  @@index([nextFollowUpAt])
  @@unique([phone, type])
  // یک شماره در هر دسته (مالک / مشتری) یک بار — یکتایی کلی در API کنترل می‌شود
}

model CustomerTransfer {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation("CustomerTransfers", fields: [customerId], references: [id], onDelete: Cascade)
  fromAgentId String?
  fromAgent   User?    @relation("TransferFrom", fields: [fromAgentId], references: [id], onDelete: SetNull)
  toAgentId   String?
  toAgent     User?    @relation("TransferTo", fields: [toAgentId], references: [id], onDelete: SetNull)
  byUserId    String?
  byUser      User?    @relation("TransferBy", fields: [byUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Property {
  id          String             @id @default(cuid())
  /// کد فایل — یکتا، برای ارجاع سریع در بنگاه (مثلا F-0001)
  code        String?            @unique
  title       String
  type        String
  dealType    PropertyDealType

  salePriceToman     BigInt?
  depositToman        BigInt?
  monthlyRentToman    BigInt?

  status      PropertyStatus     @default(ACTIVE)
  /// منبع فایل — از کجا پیدا شده (دیوار، فایل‌یابی، ...)
  source      CustomerSource?
  sizeSqm     Float?
  beds        Int?
  builtYear   Int?
  floor       Int?
  totalFloors Int?
  /// تعداد واحد در هر طبقه (آپارتمان)
  unitsPerFloor Int?
  /// تعداد کل واحدها (آپارتمان)
  unitCount     Int?
  /// متراژ زمین — ویلا/کلنگی/زمین
  landSizeSqm   Float?
  /// عرض گذر (متر)
  passageWidth  Float?
  /// برِ ملک (متر)
  buildingFrontage Float?
  /// تعداد طبقات بنا — ویلا/کلنگی
  buildingFloors   Int?

  hasParking  Boolean            @default(false)
  hasStorage  Boolean            @default(false)
  hasElevator Boolean            @default(false)
  hasTerrace  Boolean            @default(false)
  /// بازسازی‌شده — برای جستجوی بعدی
  hasRenovated Boolean           @default(false)
  /// نوساز — برای جستجوی بعدی
  isNewBuild   Boolean           @default(false)

  region      String
  address     String?
  /// توضیحات/نکات فایل — «مالک عجله دارد»، «قیمت قابل مذاکره است» و...
  description String?
  images      String[]           @default([])

  isAdvertised        Boolean   @default(false)
  nextOwnerFollowUpAt DateTime?

  /// آیا مشاور فایل را حضوری کارشناسی کرده؟
  isAppraised     Boolean    @default(false)
  appraisedById   String?
  appraisedBy     User?      @relation("PropertyAppraiser", fields: [appraisedById], references: [id])
  appraisedAt     DateTime?

  ownerId     String
  owner       Customer           @relation("PropertyOwner", fields: [ownerId], references: [id])

  listedById  String
  listedBy    User               @relation("PropertyLister", fields: [listedById], references: [id])

  visibility  PropertyVisibility @default(TEAM_VISIBLE)
  accessList  PropertyAccess[]

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  viewings Viewing[]
  deals    Deal[]
  activities Activity[]

  @@index([listedById])
  @@index([region])
  @@index([type])
  @@index([dealType])
  @@index([status, visibility])
  @@index([dealType, status])
  @@index([region, type, dealType, status, deletedAt])
  @@index([source])
}

model PropertyAccess {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  grantedById String
  grantedBy   User      @relation("AccessGrantedBy", fields: [grantedById], references: [id])
  reason      String?
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?

  @@unique([propertyId, userId])
  @@index([propertyId, userId])
  @@index([revokedAt, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Viewing {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  propertyId String
  property   Property      @relation(fields: [propertyId], references: [id])
  agentId    String
  agent      User          @relation("ViewingAgent", fields: [agentId], references: [id])
  startAt    DateTime
  endAt      DateTime?
  status     ViewingStatus @default(SCHEDULED)
  feedback   String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([agentId])
  @@index([propertyId])
}

enum DealStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum CashboxType {
  IN
  OUT
}

model Deal {
  id         String     @id @default(cuid())
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id])
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id])
  agentId    String
  agent      User       @relation("DealAgent", fields: [agentId], references: [id])
  shares     DealShare[]

  status      DealStatus @default(PENDING)
  contractAt  DateTime?
  notes       String?
  commissionToman   BigInt?
  commissionPercent Float?
  sellerShiriniToman BigInt?
  buyerShiriniToman  BigInt?
  commissionPaid    Boolean  @default(false)
  commissionPaidAt  DateTime?
  officePct         Decimal  @default(50) @db.Decimal(5, 2)

  dealSalePriceToman   BigInt?
  dealDepositToman     BigInt?
  dealMonthlyRentToman BigInt?

  canceledAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId, status])
  @@index([propertyId, status])
  @@index([agentId, status])
  @@index([status, createdAt])
}

model DealShare {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation("DealShareUser", fields: [userId], references: [id], onDelete: SetNull)
  name      String
  pct       Decimal  @db.Decimal(5, 2)
  settled   Boolean  @default(false)
  settledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@index([userId])
}

model CashboxEntry {
  id          String      @id @default(cuid())
  type        CashboxType
  amount      BigInt
  title       String
  note        String?
  occurredAt  DateTime    @default(now())
  createdById String
  createdBy   User        @relation("CashboxCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())

  @@index([occurredAt])
  @@index([createdById])
}

model FollowUp {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dueAt      DateTime
  note       String?
  done       Boolean  @default(false)
  doneAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, done, dueAt])
  @@index([customerId, dueAt])
}

model Task {
  id              String    @id @default(cuid())
  relatedType     String?
  relatedId       String?
  title           String
  dueAt           DateTime?
  priority        Int       @default(0)
  done            Boolean   @default(false)
  assignedAgentId String
  assignedAgent   User      @relation("TaskAgent", fields: [assignedAgentId], references: [id])
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([assignedAgentId])
}

model Notification {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
  type        NotificationType
  priority    NotificationPriority @default(NORMAL)
  relatedType String?
  relatedId   String?
  message     String
  read        Boolean              @default(false)
  readAt      DateTime?
  createdAt   DateTime             @default(now())

  @@index([userId, read, createdAt])
}

model Activity {
  id              String       @id @default(cuid())
  type            ActivityType
  agentId         String
  agent           User         @relation(fields: [agentId], references: [id])
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id])
  propertyId      String?
  property        Property?    @relation(fields: [propertyId], references: [id])
  description     String?
  durationMinutes Int?
  costToman       Int?
  oldValue        String?
  newValue        String?
  createdAt       DateTime     @default(now())

  @@index([agentId, createdAt])
  @@index([customerId, createdAt])
  @@index([propertyId, createdAt])
}


/// ثبت خطاهای سمت سرور برای مشاهده توسط مدیر (نقد ۶ — مشاهده‌پذیری).
/// اگر جدول در دیتابیس نباشد، logApiError به console.error برمی‌گردد و خطا نمی‌دهد.
model ApiErrorLog {
  id        String   @id @default(cuid())
  route     String
  method    String
  status    Int
  message   String
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([route, createdAt])
}

/// شمارندهٔ محدودیت نرخ ورود (نقد ۱۳) — جایگزین دیتابیسیِ محدودیت درون‌حافظه‌ای.
/// اگر جدول نباشد، rateLimitDb به حافظه برمی‌گردد.
model RateLimitHit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(1)
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}
